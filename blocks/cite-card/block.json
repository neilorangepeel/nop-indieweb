{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/cite-card",
	"title": "Cite Card",
	"description": "Displays the captured context for a like, bookmark, reply, or repost — title linked to source, author, and excerpt.",
	"category": "nop-indieweb-conversations",
	"icon": "external",
	"editorScript": "file:./editor.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ],
	"render": "file:./render.php",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": false,
		"multiple": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": false,
			"link": true,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	}
}
