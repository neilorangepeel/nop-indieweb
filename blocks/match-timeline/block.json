{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/match-timeline",
	"title": "Match Timeline",
	"description": "A Match post's takes and its automated events (goals, cards, subs, VAR) in minute order. Renders nothing on any other post.",
	"category": "nop-indieweb-meta",
	"icon": "list-view",
	"keywords": [ "match", "football", "takes", "live", "timeline" ],
	"editorScript": "file:./editor.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ],
	"render": "file:./render.php",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"__experimentalDefaultControls": { "text": true }
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	}
}
