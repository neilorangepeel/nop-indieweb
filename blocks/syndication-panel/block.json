{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/syndication-panel",
	"title": "Syndication Panel",
	"description": "Shows where this post is also being discussed on Mastodon, Bluesky, Pixelfed, etc. Renders nothing when the post has no syndication links.",
	"category": "nop-indieweb-conversations",
	"icon": "share-alt2",
	"keywords": [ "syndication", "posse", "mastodon", "bluesky", "pixelfed", "indieweb" ],
	"editorScript": "file:./editor.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ],
	"render": "file:./render.php",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": false,
			"link": true,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	}
}
