{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/share-button",
	"title": "Share Button",
	"category": "nop-indieweb-conversations",
	"icon": "share",
	"description": "Shares the post: the device's share sheet on a phone, otherwise copies its link.",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": false,
		"typography": {
			"fontSize": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"text": true,
			"background": false,
			"gradients": false,
			"link": false
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./editor.js",
	"viewScriptModule": "file:./view.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ]
}
