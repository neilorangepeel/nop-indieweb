{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/film-card",
	"title": "Film Card",
	"category": "nop-indieweb-meta",
	"icon": "format-video",
	"description": "Compact film card for diary archive listings. Shows poster, star rating, title, and watch date.",
	"selectors": {
		"border": ".wp-block-nop-indieweb-film-card .nop-film-card__poster"
	},
	"supports": {
		"html": false,
		"align": false,
		"multiple": true,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": false,
			"link": true,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"usesContext": [ "postId", "postType", "queryId" ],
	"render": "file:./render.php",
	"editorScript": "file:./editor.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ]
}
