{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nop-indieweb/film-meta",
	"title": "Film Meta",
	"description": "Star rating, watch date, and Letterboxd attribution for a film diary entry. The rating is editable by clicking the stars directly in the block editor.",
	"category": "nop-indieweb-meta",
	"icon": "star-filled",
	"keywords": ["film", "letterboxd", "rating", "stars", "watch", "movie"],
	"editorScript": "file:./editor.js",
	"style": [ "file:./style.css", "nop-blocks-shared" ],
	"render": "file:./render.php",
	"usesContext": ["postId", "postType"],
	"selectors": {
		"border": ".wp-block-nop-indieweb-film-meta .nop-film-meta__poster"
	},
	"supports": {
		"html": false,
		"align": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": false,
			"link": false,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	}
}
